    {
      "id": "c16",
      "text": "주역으로 꼽히는 건,",
      "start": 22.2,
      "end": 23.8,
      "emphasis": []
    },
    {
      "id": "c17",
      "text": "그 안에 모인",
      "start": 23.8,
      "end": 24.74,
      "emphasis": []
    },
    {
      "id": "c18",
      "text": "무거운 별들입니다.",
      "start": 24.74,
      "end": 26.32,
      "emphasis": []
    },
    {
      "id": "c19",
      "text": "별은 빛만 내보내지 않습니다.",
      "start": 26.62,
      "end": 28.64,
      "emphasis": []
    },
    {
      "id": "c21",
      "text": "빠른 입자의 흐름,",
      "start": 28.94,
      "end": 30.2,
      "emphasis": []
    },
    {
      "id": "c22",
      "text": "항성풍도 뿜어냅니다.",
      "start": 30.54,
      "end": 31.84,
      "emphasis": []
    },
    {
      "id": "c23",
      "text": "여기에 무거운 별이",
      "start": 32.14,
      "end": 33.04,
      "emphasis": []
    },
    {
      "id": "c24",
      "text": "초신성으로 폭발할 때의",
      "start": 33.04,
      "end": 34.62,
      "emphasis": []
    },
    {
      "id": "c25",
      "text": "충격파까지 더해집니다.",
      "start": 34.62,
      "end": 36.04,
      "emphasis": []
    },
    {
      "id": "c26",
      "text": "이 힘들이 주변 가스를",
      "start": 36.38,
      "end": 37.96,
      "emphasis": []
    },
    {
      "id": "c27",
      "text": "바깥으로 밀어낸다는",
      "start": 37.96,
      "end": 39.56,
      "emphasis": []
    },
    {
      "id": "c28",
      "text": "설명입니다.",
      "start": 39.56,
      "end": 40.34,
      "emphasis": []
    },
    {
      "id": "c29",
      "text": "그렇다면, 밀려난 가스는",
      "start": 40.64,
      "end": 42.66,
      "emphasis": []
    },
    {
      "id": "c30",
      "text": "어디로 갔을까요?",
      "start": 42.66,
      "end": 43.88,
      "emphasis": []
    },
    {
      "id": "c31",
      "text": "사라진 게 아닙니다.",
      "start": 44.18,
      "end": 46.32,
      "emphasis": []
    },
    {
      "id": "c32",
      "text": "바깥에 쌓여,",
      "start": 46.66,
      "end": 47.36,
      "emphasis": []
    },
    {
      "id": "c33",
      "text": "더 촘촘한",
      "start": 47.36,
      "end": 48.6,
      "emphasis": []
    },
    {
      "id": "c34",
      "text": "가스 껍질을 이룹니다.",
      "start": 48.6,
      "end": 50.62,
      "emphasis": []
    },
    {
      "id": "c35",
      "text": "그런데 이 압축된 껍질은,",
      "start": 50.92,
      "end": 52.92,
      "emphasis": []
    },
    {
      "id": "c36",
      "text": "다음 별이 태어나는",
      "start": 52.92,
      "end": 54.24,
      "emphasis": []
    },
    {
      "id": "c37",
      "text": "재료가 됩니다.",
      "start": 54.24,
      "end": 55.135,
      "emphasis": []
    },
    {
      "id": "c38",
      "text": "차가운 가스가 뭉쳐",
      "start": 55.36,
      "end": 56.4,
      "emphasis": []
    },
    {
      "id": "c39",
      "text": "조밀해지는 것.",
      "start": 56.4,
      "end": 58.1,
      "emphasis": []
    },
    {
      "id": "c40",
      "text": "별 탄생의 첫 단계죠.",
      "start": 58.4,
      "end": 60.66,
      "emphasis": []
    },
    {
      "id": "c41",
      "text": "허블이 이 일대에서",
      "start": 60.96,
      "end": 62.06,
      "emphasis": []
    },
    {
      "id": "c42",
      "text": "찾아낸 아주 어린 별은",
      "start": 62.06,
      "end": 63.76,
      "emphasis": []
    },
    {
      "id": "c43",
      "text": "약 3만개.",
      "start": 63.76,
      "end": 64.82,
      "emphasis": []
    },
    {
      "id": "c44",
      "text": "아직 중심에서",
      "start": 65.24,
      "end": 66.54,
      "emphasis": []
    },
    {
      "id": "c45",
      "text": "수소 핵융합을",
      "start": 66.54,
      "end": 67.58,
      "emphasis": []
    },
    {
      "id": "c46",
      "text": "시작하지 않은 별들입니다.",
      "start": 67.58,
      "end": 69.9,
      "emphasis": []
    },
    {
      "id": "c47",
      "text": "다 자란 별과",
      "start": 70.12,
      "end": 70.92,
      "emphasis": []
    },
    {
      "id": "c48",
      "text": "막 태어나는 별을,",
      "start": 70.92,
      "end": 72.28,
      "emphasis": []
    },
    {
      "id": "c49",
      "text": "한곳에서 함께 보는",
      "start": 72.28,
      "end": 73.6,
      "emphasis": []
    },
    {
      "id": "c50",
      "text": "셈이죠.",
      "start": 73.6,
      "end": 74.2,
      "emphasis": []
    },
    {
      "id": "c51",
      "text": "거대한 구멍은",
      "start": 74.56,
      "end": 75.72,
      "emphasis": []
    },
    {
      "id": "c52",
      "text": "끝이 아니었습니다.",
      "start": 75.72,
      "end": 77.18,
      "emphasis": []
    },
    {
      "id": "c53",
      "text": "별이 비워낸 자리의",
      "start": 77.48,
      "end": 78.88,
      "emphasis": []
    },
    {
      "id": "c54",
      "text": "가장자리에서,",
      "start": 78.88,
      "end": 80.34,
      "emphasis": []
    },
    {
      "id": "c55",
      "text": "다음 세대의 별이",
      "start": 80.34,
      "end": 81.92,
      "emphasis": []
    },
    {
      "id": "c56",
      "text": "시작되고 있습니다.",
      "start": 81.92,
      "end": 83.10000000000001,
      "emphasis": []
    }
  ]
}
