        "release_sec": 1.2,
        "why": "<예: 대본 제작 메모 — 인용구 BGM 낮춤>"
      }
    ],
    "fade_in_sec": 1.0,
    "fade_out_sec": 3.0,
    "start_offset_sec": 0,
    "loop": false,
    "credit": "Music: <title> by <artist> — <source>",
    "source_lufs": null,
    "intro_silence_sec": null
  },
  "sfx": [
