{
  "schema_version": "1.0",
  "_comment": "소리층. bgm.file/sfx[].file 이 null 이면 그 트랙은 건너뛴다. dB 는 렌더에서 선형 변환. start_offset_sec = assets.json intro_silence_sec + 0.5 | BGM 레벨 기준: 발화 중 내레이션 −12~−15 dB 아래(1편 −24 base 폐기), 확정은 사용자 청취. duck_ranges = 대본·클라이언트 구간 지시(인용구 낮춤 등)",
  "narration": {
    "file": "pilot/audio/narration.wav",
    "normalized": {
      "target_lufs": -16,
      "true_peak": -1.5
    },
    "gain_db": 0
  },
  "bgm": {
    "asset": "<audio_assets id>",
    "file": "pilot/audio/<bgm>.mp3",
    "gain_db": -8,
    "duck_db": -10,
    "duck_attack_sec": 0.25,
    "duck_release_sec": 0.6,
    "duck_ranges": [
      {
        "from": 0.0,
        "to": 0.0,
        "gain_db": -18,
