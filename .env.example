# 이 파일을 `.env` 로 복사하고 값을 채운다. `.env` 는 Git에 올라가지 않는다.
# 스크립트는 환경변수 → 저장소 `.env` → (macOS에서만) 키체인 순으로 읽는다.

# 스톡 자료 검색 — plugin/skills/shortform-news-input/scripts/{stock,brief}_search.py
# 발급: https://www.pexels.com/api/  ·  https://pixabay.com/api/docs/  ·  https://unsplash.com/developers
PEXELS_API_KEY=
PIXABAY_API_KEY=
UNSPLASH_ACCESS_KEY=

# 내레이션 TTS — plugin/skills/shortform-news-input/scripts/make_narration.py
# 발급: https://typecast.ai  (API 키). 음성은 계정마다 다르므로 사용할 voice_id 를 함께 적는다.
TYPECAST_API_KEY=
TYPECAST_VOICE_ID=
TYPECAST_VOICE_NAME=

# 외부 API에 보낼 연락처. 비워도 동작한다 (User-Agent 에 붙는다).
SHORTFORM_CONTACT=

# Higgsfield 는 API 키가 아니라 claude.ai 커넥터로 연결한다 — README 의 "생성 서비스 연결" 참고.
