{
  "name": "shortform-motion-canvas",
  "private": true,
  "version": "0.1.0",
  "description": "숏폼 도해 클립 생성기 — Motion Canvas 벡터 인포그래픽 (렌더 결과는 파일로 파이프라인에 공급, 엔진과 무의존)",
  "type": "module",
  "scripts": {
    "editor": "vite",
    "check": "tsc -p . --noEmit",
    "build": "tsc -p . --noEmit && vite build"
  },
  "dependencies": {
    "@motion-canvas/2d": "^3.17.2",
    "@motion-canvas/core": "^3.17.2",
    "@motion-canvas/ffmpeg": "^3.17.2",
    "@motion-canvas/ui": "^3.17.2",
    "@motion-canvas/vite-plugin": "^3.17.2",
    "typescript": "~5.5.4",
    "vite": "^5.4.21"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
