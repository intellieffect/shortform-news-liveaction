{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "primitives.props.schema.v1.2",
 "title": "Graphic primitives — props JSON Schema v1.2",
 "description": "output 4-3 ③ 확정 props(2026-08-28)를 스키마로 굳힌 것. shots.graphics[] / overlays 의 primitive props 검증용. 좌표 단위: px = 1080×1920 캔버스 픽셀, ratio = 0~1. 공통 필드 in(초, 비트 시작 기준)은 graphics[] 엔트리에 있고 props 밖. | v1.2a: inset@1을 output shots.insets[] 실제 필드(asset·file·src_size·x·y·w·opacity·border·label·credit)로 맞춤 (2026-08-28).",
 "$defs": {
  "px": {
   "type": "number",
   "minimum": 0
  },
  "ratio": {
   "type": "number",
   "minimum": 0,
   "maximum": 1
  },
  "point_px": {
   "type": "object",
   "required": [
    "x",
    "y"
   ],
   "properties": {
    "x": {
     "$ref": "#/$defs/px"
    },
    "y": {
     "$ref": "#/$defs/px"
    }
   },
   "additionalProperties": false
  },
  "rect_ratio": {
   "type": "object",
   "required": [
    "x",
    "y",
    "w",
    "h"
   ],
   "properties": {
    "x": {
     "$ref": "#/$defs/ratio"
    },
    "y": {
     "$ref": "#/$defs/ratio"
    },
    "w": {
     "$ref": "#/$defs/ratio"
    },
    "h": {
     "$ref": "#/$defs/ratio"
    }
   },
   "additionalProperties": false
  },
  "image_ref": {
   "type": "object",
   "required": [
    "file"
   ],
   "properties": {
    "file": {
     "type": "string",
     "description": "public/ 기준 경로. 알파 PNG"
    },
    "size": {
     "$ref": "#/$defs/px",
     "description": "긴 변 px"
    }
   },
   "additionalProperties": false
  },
  "graphics_entry": {
   "type": "object",
   "required": [
    "id",
    "props"
   ],
   "properties": {
    "id": {
     "type": "string",
     "pattern": "^[a-z_]+@[0-9]+$",
     "description": "레지스트리 id. 미등록·deprecated면 check-shots 에러"
    },
    "in": {
     "type": "number",
     "minimum": 0,
     "description": "비트 시작 기준 초. 생략 = 0"
    },
    "props": {
     "type": "object"
    },
    "note": {
     "type": "string",
     "description": "facts.md 규칙 인용 권장 (예: 'facts #6')"
    }
   },
   "allOf": [
    {
     "if": {
      "properties": {
       "id": {
        "const": "counter@1"
       }
      }
     },
     "then": {
      "properties": {
       "props": {
        "$ref": "#/$defs/counter_v1"
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "id": {
        "const": "evidence_card@1"
       }
      }
     },
     "then": {
      "properties": {
       "props": {
        "$ref": "#/$defs/evidence_card_v1"
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "id": {
        "const": "dot@1"
       }
      }
     },
     "then": {
      "properties": {
       "props": {
        "$ref": "#/$defs/dot_v1"
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "id": {
        "const": "measure@1"
       }
      }
     },
     "then": {
      "properties": {
       "props": {
        "$ref": "#/$defs/measure_v1"
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "id": {
        "const": "diagram@1"
       }
      }
     },
     "then": {
      "properties": {
       "props": {
        "$ref": "#/$defs/diagram_v1"
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "id": {
        "const": "inset@1"
       }
      }
     },
     "then": {
      "properties": {
       "props": {
        "$ref": "#/$defs/inset_v1"
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "id": {
        "const": "hook_title@1"
       }
      }
     },
     "then": {
      "properties": {
       "props": {
        "$ref": "#/$defs/hook_title_v1"
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "id": {
        "const": "arrow_step@1"
       }
      }
     },
     "then": {
      "properties": {
       "props": {
        "$ref": "#/$defs/arrow_step_v1"
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "id": {
        "const": "stat_block@1"
       }
      }
     },
     "then": {
      "properties": {
       "props": {
        "$ref": "#/$defs/stat_block_v1"
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "id": {
        "const": "equation_block@1"
       }
      }
     },
     "then": {
      "properties": {
       "props": {
        "$ref": "#/$defs/equation_block_v1"
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "id": {
        "const": "bullet_list@1"
       }
      }
     },
     "then": {
      "properties": {
       "props": {
        "$ref": "#/$defs/bullet_list_v1"
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "id": {
        "const": "quote_slab@1"
       }
      }
     },
     "then": {
      "properties": {
       "props": {
        "$ref": "#/$defs/quote_slab_v1"
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "id": {
        "const": "cta_bar@1"
       }
      }
     },
     "then": {
      "properties": {
       "props": {
        "$ref": "#/$defs/cta_bar_v1"
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "id": {
        "const": "veil@1"
       }
      }
     },
     "then": {
      "properties": {
       "props": {
        "$ref": "#/$defs/veil_v1"
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "id": {
        "const": "reveal@1"
       }
      }
     },
     "then": {
      "properties": {
       "props": {
        "$ref": "#/$defs/reveal_v1"
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "id": {
        "const": "orbit_deploy@1"
       }
      }
     },
     "then": {
      "properties": {
       "props": {
        "$ref": "#/$defs/orbit_deploy_v1"
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "id": {
        "const": "radius_map@1"
       }
      }
     },
     "then": {
      "properties": {
       "props": {
        "$ref": "#/$defs/radius_map_v1"
       }
      }
     }
    }
   ]
  },
  "counter_v1": {
   "type": "object",
   "required": [
    "from",
    "to"
   ],
   "properties": {
    "from": {
     "type": "number"
    },
    "to": {
     "type": "number"
    },
    "suffix": {
     "type": "string",
     "default": ""
    },
    "duration": {
     "type": "number",
     "exclusiveMinimum": 0,
     "default": 1.4,
     "description": "초"
    },
    "center": {
     "$ref": "#/$defs/point_px"
    },
    "earth": {
     "$ref": "#/$defs/image_ref"
    },
    "dots": {
     "type": "integer",
     "minimum": 0,
     "description": "장식용 점 개수 — 사실 수치와 무관"
    },
    "label": {
     "type": "string"
    },
    "format": {
     "enum": [
      "ko",
      "arabic"
     ],
     "default": "ko",
     "description": "ko=만 단위(176만), arabic=1,766,623 (대본 자막 표기 따를 때)"
    }
   },
   "additionalProperties": false,
   "x-rules": [
    "중간값이 사실로 읽히지 않게: 내역 숫자 노출 금지 (facts #6). 화면 숫자는 to 하나만 사실",
    "kind: static (등장 애니는 textAnim 토글 하위)"
   ]
  },
  "evidence_card_v1": {
   "type": "object",
   "required": [
    "file",
    "src_size",
    "crop",
    "source"
   ],
   "properties": {
    "file": {
     "type": "string"
    },
    "src_size": {
     "type": "array",
     "items": {
      "type": "integer",
      "minimum": 1
     },
     "minItems": 2,
     "maxItems": 2
    },
    "crop": {
     "$ref": "#/$defs/rect_ratio"
    },
    "highlight": {
     "oneOf": [
      {
       "$ref": "#/$defs/rect_ratio"
      },
      {
       "type": "null"
      }
     ],
     "description": "crop 원본 좌표계(ratio). null = 없음"
    },
    "quote": {
     "type": [
      "string",
      "null"
     ],
     "description": "원문 그대로(verbatim). 축약·의역 금지 (facts #27)"
    },
    "source": {
     "type": "string",
     "minLength": 1,
     "description": "소출처 표기 문자열"
    },
    "x": {
     "$ref": "#/$defs/px"
    },
    "y": {
     "$ref": "#/$defs/px"
    },
    "w": {
     "$ref": "#/$defs/px"
    }
   },
   "additionalProperties": false,
   "x-rules": [
    "file은 assets.json overlay_assets/brief_assets에 등록된 문서(license·credit 있음)만",
    "SF-P13 SOURCE_DOCUMENT_EVIDENCE 대응"
   ]
  },
  "dot_v1": {
   "type": "object",
   "required": [
    "x",
    "y"
   ],
   "properties": {
    "x": {
     "$ref": "#/$defs/px"
    },
    "y": {
     "$ref": "#/$defs/px"
    },
    "r": {
     "$ref": "#/$defs/px",
     "default": 10
    },
    "pulse": {
     "type": "boolean",
     "default": false
    },
    "label": {
     "type": [
      "string",
      "null"
     ]
    }
   },
   "additionalProperties": false
  },
  "measure_v1": {
   "type": "object",
   "required": [
    "unit",
    "a",
    "b"
   ],
   "properties": {
    "x": {
     "$ref": "#/$defs/px"
    },
    "y": {
     "$ref": "#/$defs/px"
    },
    "unit": {
     "type": "number",
     "exclusiveMinimum": 0,
     "description": "값 1당 px"
    },
    "a": {
     "type": "object",
     "required": [
      "label",
      "value"
     ],
     "properties": {
      "label": {
       "type": "string"
      },
      "value": {
       "type": "number"
      },
      "image": {
       "$ref": "#/$defs/image_ref"
      }
     },
     "additionalProperties": false
    },
    "b": {
     "type": "object",
     "required": [
      "label",
      "value"
     ],
     "properties": {
      "label": {
       "type": "string"
      },
      "value": {
       "type": "number"
      },
      "image": {
       "$ref": "#/$defs/image_ref"
      }
     },
     "additionalProperties": false
    },
    "note": {
     "type": "string",
     "description": "비교 조건 문구 — 조건부 사실이면 필수 (예: '반사광 안에서 볼 때', facts #11)"
    }
   },
   "additionalProperties": false,
   "x-rules": [
    "같은 단위·같은 질문의 두 값만 (SF-P05:v4)",
    "a/b value는 facts.md 항목 번호로 근거 추적 가능해야 함"
   ]
  },
  "diagram_v1": {
   "type": "object",
   "required": [
    "nodes",
    "arrows"
   ],
   "properties": {
    "title": {
     "type": "string"
    },
    "nodes": {
     "type": "array",
     "minItems": 2,
     "maxItems": 6,
     "items": {
      "type": "object",
      "required": [
       "icon",
       "x",
       "y",
       "label"
      ],
      "properties": {
       "icon": {
        "type": "string",
        "enum": [
         "sun",
         "satellite",
         "planet",
         "mirror",
         "ground",
         "telescope",
         "star",
         "eye",
         "world",
         "moon-stars",
         "file-text"
        ]
       },
       "x": {
        "$ref": "#/$defs/px"
       },
       "y": {
        "$ref": "#/$defs/px"
       },
       "label": {
        "type": "string"
       },
       "size": {
        "$ref": "#/$defs/px",
        "default": 100
       }
      },
      "additionalProperties": false
     }
    },
    "arrows": {
     "type": "array",
     "items": {
      "type": "array",
      "items": {
       "type": "integer",
       "minimum": 0
      },
      "minItems": 2,
      "maxItems": 2
     }
    }
   },
   "additionalProperties": false,
   "x-rules": [
    "화살표 = 물리적 경로(빛·궤도)만. 기사에 없는 인과 주장 금지 (facts #25)",
    "실물 오인 방지: 실존 하드웨어 노드는 label에 '(추상)' 또는 '실물 아님' 표기 (facts #9)",
    "icon은 Tabler MIT 세트 내"
   ]
  },
  "inset_v1": {
   "type": "object",
   "required": [
    "file",
    "src_size",
    "x",
    "y",
    "w"
   ],
   "properties": {
    "asset": {
     "type": [
      "string",
      "null"
     ],
     "description": "assets.json id (overlay_assets/brief_assets/external_assets). null = 레지스트리 밖 파일(허용하지 않음 — 경고)"
    },
    "file": {
     "type": "string",
     "description": "public/ 기준 경로"
    },
    "src_size": {
     "type": "array",
     "items": {
      "type": "integer",
      "minimum": 1
     },
     "minItems": 2,
     "maxItems": 2
    },
    "x": {
     "$ref": "#/$defs/px"
    },
    "y": {
     "$ref": "#/$defs/px"
    },
    "w": {
     "$ref": "#/$defs/px"
    },
    "opacity": {
     "$ref": "#/$defs/ratio",
     "default": 1
    },
    "border": {
     "type": "boolean",
     "default": false
    },
    "label": {
     "type": "string",
     "description": "예측·시뮬레이션·지상시험 이미지엔 필수 (facts C)"
    },
    "credit": {
     "type": "string",
     "description": "source=external(CC BY)이면 필수"
    }
   },
   "additionalProperties": false,
   "x-rules": [
    "w ≤ src_size[0] (업스케일 금지 — check-shots 경고)",
    "asset이 external(CC BY)이면 credit 필수, stock이면 권장",
    "등장 애니 고정: 6f 지연 + 10f 상승 (props로 제어 안 함)",
    "crop·in/out_frames·shrink_px는 v1에 없음 — 필요 시 inset@2"
   ]
  },
  "hook_title_v1": {
   "type": "object",
   "required": [],
   "properties": {
    "kicker": {
     "type": "string"
    },
    "kicker_in": {
     "type": "number",
     "minimum": 0,
     "description": "비트 시작 기준 초 — 내레이션에서 그 말을 하는 시각"
    },
    "title": {
     "type": "string"
    },
    "title_in": {
     "type": "number",
     "minimum": 0,
     "description": "비트 시작 기준 초 — 내레이션에서 그 말을 하는 시각"
    },
    "y": {
     "$ref": "#/$defs/ratio"
    },
    "scrim": {
     "$ref": "#/$defs/ratio"
    }
   },
   "additionalProperties": false,
   "x-rules": [
    "문구는 대본 「자막(온스크린 텍스트)」 열 그대로 — 조판만 우리 몫",
    "*_in 은 내레이션 낱말 시각(초). 매핑은 shots.json onscreen_map 이 단일 소스"
   ]
  },
  "arrow_step_v1": {
   "type": "object",
   "required": [],
   "properties": {
    "before": {
     "type": "string"
    },
    "before_in": {
     "type": "number",
     "minimum": 0,
     "description": "비트 시작 기준 초 — 내레이션에서 그 말을 하는 시각"
    },
    "arrow": {
     "type": "string"
    },
    "after": {
     "type": "string"
    },
    "after_in": {
     "type": "number",
     "minimum": 0,
     "description": "비트 시작 기준 초 — 내레이션에서 그 말을 하는 시각"
    },
    "y": {
     "$ref": "#/$defs/ratio"
    },
    "scrim": {
     "$ref": "#/$defs/ratio"
    }
   },
   "additionalProperties": false,
   "x-rules": [
    "문구는 대본 「자막(온스크린 텍스트)」 열 그대로 — 조판만 우리 몫",
    "*_in 은 내레이션 낱말 시각(초). 매핑은 shots.json onscreen_map 이 단일 소스"
   ]
  },
  "stat_block_v1": {
   "type": "object",
   "required": [],
   "properties": {
    "lead": {
     "type": "string"
    },
    "lead_in": {
     "type": "number",
     "minimum": 0,
     "description": "비트 시작 기준 초 — 내레이션에서 그 말을 하는 시각"
    },
    "compare": {
     "type": "string"
    },
    "value": {
     "type": "string"
    },
    "tail": {
     "type": "string"
    },
    "value_in": {
     "type": "number",
     "minimum": 0,
     "description": "비트 시작 기준 초 — 내레이션에서 그 말을 하는 시각"
    },
    "sub": {
     "type": "string"
    },
    "y": {
     "$ref": "#/$defs/ratio"
    },
    "scrim": {
     "$ref": "#/$defs/ratio"
    },
    "bar": {
     "type": "object",
     "required": [
      "a",
      "b"
     ],
     "properties": {
      "a": {
       "type": "object",
       "required": [
        "label",
        "value"
       ],
       "properties": {
        "label": {
         "type": "string"
        },
        "value": {
         "type": "number"
        },
        "image": {
         "$ref": "#/$defs/image_ref"
        }
       },
       "additionalProperties": false
      },
      "b": {
       "type": "object",
       "required": [
        "label",
        "value"
       ],
       "properties": {
        "label": {
         "type": "string"
        },
        "value": {
         "type": "number"
        }
       },
       "additionalProperties": false
      },
      "unit": {
       "type": "number"
      },
      "in": {
       "type": "number",
       "minimum": 0
      }
     },
     "additionalProperties": false,
     "description": "같은 사실의 비교 막대 — measure@1 을 같은 비트에 따로 두지 않는다"
    }
   },
   "additionalProperties": false,
   "x-rules": [
    "문구는 대본 「자막(온스크린 텍스트)」 열 그대로 — 조판만 우리 몫",
    "*_in 은 내레이션 낱말 시각(초). 매핑은 shots.json onscreen_map 이 단일 소스"
   ]
  },
  "equation_block_v1": {
   "type": "object",
   "required": [
    "lhs",
    "rhs"
   ],
   "properties": {
    "lhs": {
     "type": "string"
    },
    "lhs_in": {
     "type": "number",
     "minimum": 0,
     "description": "비트 시작 기준 초 — 내레이션에서 그 말을 하는 시각"
    },
    "rhs": {
     "type": "string"
    },
